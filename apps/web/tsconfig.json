{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@void/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@void/tokens/*": [
        "../../packages/tokens/dist/*"
      ],
      "@void/market": [
        "../../packages/market/src"
      ],
      "@void/market/*": [
        "../../packages/market/src/*"
      ],
      "@void/trade": [
        "../../packages/trade/src"
      ],
      "@void/trade/*": [
        "../../packages/trade/src/*"
      ],
      "@void/order": [
        "../../packages/order/src"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
